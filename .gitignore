# ==============================================================================
# NeuroPulse - Git Ignore Configuration
# Multi-stack: Python (FastAPI/Scikit-Learn) + React (JavaScript/Tailwind/Three)
# ==============================================================================

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/.venv/
**/venv/
**/.venv/

# ------------------------------------------------------------------------------
# Node.js & Frontend Builds
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
jspm_packages/
.npm
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Production Build Output
frontend/build/
**/build/
frontend/dist/
dist/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (Keep .env.example tracked)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# ------------------------------------------------------------------------------
# Machine Learning Datasets & Heavy Artifacts
# (Ignore full multi-hundred MB datasets to prevent GitHub rejection;
#  Keep lightweight sample datasets for out-of-the-box verification)
# ------------------------------------------------------------------------------
**/data/hrv dataset/
**/data/raw/
**/data/processed/
**/backend/data/hrv dataset/
**/backend/data/raw/
**/backend/data/processed/

# Exclude large CSV/TXT data files within data directories
**/backend/data/**/*.csv
**/backend/data/**/*.txt
**/backend/data/**/*.pdf
**/backend/data/**/*.zip

# BUT preserve minimal sample datasets and documentation
!**/backend/data/sample_train_dataset.csv
!**/backend/data/sample_test_dataset.csv
!**/backend/data/README.md

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.bak
*.swp
*.swo

# ------------------------------------------------------------------------------
# IDEs & System Artifacts
# ------------------------------------------------------------------------------
.vscode/
!.vscode/settings.json.example
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
