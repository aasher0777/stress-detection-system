# ==============================================================================
# NeuroPulse Backend - Environment Configuration Template
# Duplicate this file to '.env' and fill in your local or production values
# ==============================================================================

# Application Metadata
APP_NAME="NeuroPulse Stress Detection Backend"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# MongoDB Configuration
# (If MongoDB is not running locally, backend auto-falls back to fast in-memory store)
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DATABASE="stress_detection_db"

# Telemetry & Sampling Configuration
SAMPLING_RATE_HZ=64
WINDOW_SIZE_SECONDS=30
OVERLAP_PERCENT=50

# ML Inference Configuration
# Options: 'random_forest' | 'svm'
DEFAULT_CLASSIFIER="random_forest"
MODEL_PERSISTENCE_DIR="./saved_models"

# Google OAuth 2.0 (Role-Based Access Control)
# Used for backend token verification if enabled
GOOGLE_CLIENT_ID="585186289556-722suapet3veshgj5jjepnvnrrdc7c05.apps.googleusercontent.com"
